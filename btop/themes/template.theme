# Template, not a theme. `theme` substitutes the placeholders below from the
# sixteen slots of the deployed alacritty theme and writes the result to
# ~/.config/btop/themes/current.theme, which is the name btop.conf asks for.
#
# One template instead of one theme file per palette: the design below is a fixed
# mapping and only the hexes change, so six hand-written copies would be six
# chances for them to drift apart.
#
# A placeholder is the TOML path with the section abbreviated to one letter — p
# for [colors.primary], n for [colors.normal], b for [colors.bright] — wrapped in
# at-signs. So the bright black slot, slot 8, is the letter b, an underscore and
# the word black. Deliberately not spelled out literally anywhere in this comment:
# substitution does not skip comments, so a real placeholder written here would
# come out the other side as a hex and the explanation would eat itself.
#
# btop ships themes for all three families and none of them are used, for the
# same reason its bundled nord was rejected: all eight of its meters share one
# blue-to-white ramp, so temperature, load, memory and network paint identically.
# The per-meter ramps at the bottom of this file are the whole point.

# Empty, not the background hex: that is how the format asks for the terminal's
# own background, the same policy as transparency in nvim.
theme[main_bg]=""

theme[main_fg]="@p_foreground@"

# Box titles, and the shortcut letters that have to be findable at a glance.
theme[title]="@b_cyan@"
theme[hi_fg]="@n_yellow@"

# Slot 0 — the raised surface in every one of these palettes, a step off the
# background rather than a step into it.
theme[selected_bg]="@n_black@"
theme[selected_fg]="@b_white@"
theme[meter_bg]="@n_black@"

# Slot 8, the one value calibrated per palette because it is dim text and a
# surface at once. Both of btop's uses here are the text one.
theme[inactive_fg]="@b_black@"
theme[graph_text]="@b_black@"

theme[proc_misc]="@n_magenta@"

# Process box banner and follow mode. Only four of btop's own themes define these
# at all, so the rest fall back to stock colours for all six. The background goes
# on the accent block, not the foreground: on a light palette the accent is the
# dark half and on a dark one it is the light half, and either way the background
# is the readable of the two.
theme[proc_pause_bg]="@n_red@"
theme[proc_follow_bg]="@n_blue@"
theme[proc_banner_bg]="@n_magenta@"
theme[proc_banner_fg]="@p_background@"
theme[followed_bg]="@n_blue@"
theme[followed_fg]="@p_background@"

# Outlines on slot 8, the more visible of the two; the divider a step quieter on
# slot 0. Losing that ordering makes the boxes vanish and the dividers shout.
theme[cpu_box]="@b_black@"
theme[mem_box]="@b_black@"
theme[net_box]="@b_black@"
theme[proc_box]="@b_black@"
theme[div_line]="@n_black@"

# The gradients below are deliberately NOT all the same. Each meter has to be
# identifiable without reading its label, which is the whole failure of the
# bundled themes. Anything that means "more is worse" ends on red; the meters
# that are merely informational are flat, which the format expresses by leaving
# mid and end empty.

# Temperature: cold green through to hot red.
theme[temp_start]="@n_green@"
theme[temp_mid]="@n_yellow@"
theme[temp_end]="@n_red@"

# Load: starts cold blue instead of green so a glance separates it from temp,
# ends on the same red because a pegged cpu means the same thing.
theme[cpu_start]="@n_blue@"
theme[cpu_mid]="@n_yellow@"
theme[cpu_end]="@n_red@"

# Free memory: flat green, never a gradient — it is not a warning.
theme[free_start]="@n_green@"
theme[free_mid]=""
theme[free_end]=""

theme[cached_start]="@n_blue@"
theme[cached_mid]=""
theme[cached_end]=""

theme[available_start]="@b_cyan@"
theme[available_mid]=""
theme[available_end]=""

# Used memory: two colours starting at yellow, so it never reads green at the
# same time as the free bar sitting next to it.
theme[used_start]="@n_yellow@"
theme[used_mid]=""
theme[used_end]="@n_red@"

# Network: down cool, up warm. Confusing the two directions is the one mistake
# worth designing out here.
theme[download_start]="@n_green@"
theme[download_mid]="@b_cyan@"
theme[download_end]="@n_cyan@"

theme[upload_start]="@n_yellow@"
theme[upload_mid]="@n_magenta@"
theme[upload_end]="@n_red@"

# Per-process usage, matching the cpu ramp it sits beside.
theme[process_start]="@n_blue@"
theme[process_mid]="@n_yellow@"
theme[process_end]="@n_red@"
