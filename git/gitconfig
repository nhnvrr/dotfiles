# ~/.gitconfig — symlinked from the repo by install.sh.
# NOTE: since it's a symlink, any `git config --global ...` writes straight into
# this repo file and leaves the working tree dirty.

[user]
	name = Nicolas Navarro
	email = navarropaeznicolas@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub

[init]
	defaultBranch = main

[core]
	editor = nvim
	askPass =
	excludesfile = ~/.config/git/ignore
	# If delta isn't installed, git falls back to less without breaking.
	pager = delta

[push]
	default = upstream
	autoSetupRemote = true

[pull]
	rebase = true

[branch]
	autosetuprebase = always

[merge]
	# zdiff3 shows the common base alongside both sides of a conflict.
	conflictstyle = zdiff3

[diff]
	# histogram detects moved blocks better than the default.
	algorithm = histogram
	colorMoved = default

[interactive]
	diffFilter = delta --color-only

[delta]
	# navigate: n/N jump between files within a diff.
	navigate = true
	line-numbers = true
	# ansi: use the terminal palette, same as BAT_THEME in fish.
	syntax-theme = ansi

[rerere]
	# Replays how a conflict was resolved when it reappears. With
	# pull.rebase = true that happens often.
	enabled = true

[color]
	ui = true

[credential]
	helper = osxkeychain

[github]
	user = nhnvrr

[gpg]
	format = ssh

[gpg "ssh"]
	# Without this, commits are still signed but can't be verified locally:
	# `git log --show-signature` fails with "allowedSignersFile needs to be
	# configured and exist".
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[alias]
	prettylog = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(r) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
