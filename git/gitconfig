
[user]
	name = Nicolas Navarro
	email = navarropaeznicolas@gmail.com
	signingkey = /Users/nhnvrr/.ssh/id_ed25519.pub

[init]
	defaultBranch = main

[core]
	editor = vi
	askPass =
	excludesfile = ~/.config/git/ignore
	pager = delta

[push]
	default = simple
	autoSetupRemote = true

[pull]
	rebase = true

[branch]
	autosetuprebase = always
	autoSetupMerge = simple

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	# ansi paints syntax with the terminal's sixteen slots, so diffs follow
	# alacritty/dark.toml. The tints are its red and green over the #141516
	# ground; they are fixed hex and will look heavy on the light palette.
	syntax-theme = ansi
	minus-style = syntax "#351817"
	minus-emph-style = syntax "#541a18"
	plus-style = syntax "#2c2c17"
	plus-emph-style = syntax "#424217"
	line-numbers-minus-style = brightred
	line-numbers-plus-style = green
	line-numbers-zero-style = brightblack

[rerere]
	enabled = true

[color]
	ui = true

[credential]
	helper = osxkeychain

[github]
	user = nhnvrr

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[alias]
	prettylog = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(r) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
