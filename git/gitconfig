
[user]
	name = Nicolas Navarro
	email = navarropaeznicolas@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub

[init]
	defaultBranch = main

[core]
	editor = nvim
	askPass =
	excludesfile = ~/.config/git/ignore
	pager = delta

[push]
	default = upstream
	autoSetupRemote = true

[pull]
	rebase = true

[branch]
	autosetuprebase = always

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	syntax-theme = ansi

[rerere]
	enabled = true

[color]
	ui = true

[credential]
	helper = osxkeychain

[github]
	user = nhnvrr

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[alias]
	prettylog = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(r) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
