#!/usr/bin/env bash
#   mate              toggle light/dark
#   mate light|dark   force one, until the next system change
#   mate auto         follow macOS (what Hammerspoon calls)
#   mate status       print the active mode
set -euo pipefail

# Hammerspoon runs this through hs.task, which inherits launchd's PATH and has
# no /opt/homebrew/bin. nvim was silently not found there, so the files were
# rewritten and nothing was ever told to reload.
PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:${PATH}"

XDG_CONFIG="${XDG_CONFIG_HOME:-${HOME}/.config}"
ALACRITTY_DST="${XDG_CONFIG}/alacritty/alacritty.toml"
STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/mate"
STATE="${STATE_DIR}/appearance"
NVIM_SOCKETS="${STATE_DIR}/nvim"

# Resolved through the symlink: this is usually run as ~/.local/bin/mate, and
# a plain dirname would put the repo at ~/.local.
self="${BASH_SOURCE[0]}"
while [[ -L "${self}" ]]; do
  link="$(readlink "${self}")"
  [[ "${link}" == /* ]] && self="${link}" || self="$(dirname "${self}")/${link}"
done
REPO="$(cd "$(dirname "${self}")/.." && pwd)"
ALACRITTY_SRC="${REPO}/alacritty/alacritty.toml"

read_state() {
  [[ -r "${STATE}" ]] || return 1
  local w; w="$(tr -d '[:space:]' < "${STATE}")"
  [[ "${w}" == light || "${w}" == dark ]] || return 1
  printf '%s' "${w}"
}

system_mode() {
  # AppleInterfaceStyle is absent in light mode, not set to "Light".
  if defaults read -g AppleInterfaceStyle >/dev/null 2>&1; then printf dark; else printf light; fi
}

mode="${1:-toggle}"
case "${mode}" in
  status) read_state || system_mode; echo; exit 0 ;;
  toggle) [[ "$(read_state || system_mode)" == dark ]] && mode=light || mode=dark ;;
  auto)   mode="$(system_mode)" ;;
  light|dark) ;;
  *) echo "mate: expected light, dark, auto, toggle or status, got '${mode}'" >&2; exit 2 ;;
esac

# Generated, not linked: live_config_reload never fires on a symlinked config,
# so the file Alacritty was launched with has to be the one that changes.
#
# Both modes are a full palette in their own file and the import line names
# which one. alacritty.toml itself defines no colour, because the importing
# file overrides the imported one and any slot left up there would outlive the
# switch.
[[ -e "${ALACRITTY_SRC}" ]] || { echo "mate: ${ALACRITTY_SRC} not found" >&2; exit 1; }
[[ -L "${ALACRITTY_DST}" ]] && rm -f "${ALACRITTY_DST}"
tmp="$(mktemp)"
# awk on a literal prefix and not sed: the line is full of [ ] / . and quotes,
# and escaping all of them into a regex is how the first version of this broke.
awk -v mode="${mode}" '
  BEGIN { prefix = "import = ["; hit = 0 }
  substr($0, 1, length(prefix)) == prefix {
    hit = 1
    printf "import = [\"~/.config/alacritty/%s.toml\"]\n", mode
    next
  }
  { print }
  END { exit hit ? 0 : 1 }
' "${ALACRITTY_SRC}" > "${tmp}" || {
  echo "mate: import line not found in ${ALACRITTY_SRC}" >&2; rm -f "${tmp}"; exit 1
}
mkdir -p "$(dirname "${ALACRITTY_DST}")"
cat "${tmp}" > "${ALACRITTY_DST}"
rm -f "${tmp}"

mkdir -p "${STATE_DIR}"
printf '%s\n' "${mode}" > "${STATE}"


# tmux draws from the ANSI slots like everything else, but three things do not
# survive the switch on their own. The pane border grey is not the same slot
# name in both palettes -- brightblack in gruvbox dark, white in GitHub light.
# The dim applied to the inactive pane has no slot at all: its background sits
# one step off the ground. And the text on the green status bar cannot be a
# slot either in light, where nothing is light enough to sit on #024c1a.
# tmux.conf reads the state file for the same reason, covering a server that
# starts later.
if command -v tmux >/dev/null 2>&1 && tmux has-session >/dev/null 2>&1; then
  dim=brightblack
  inactive='fg=#928374,bg=#141617'
  status_fg=black
  if [[ "${mode}" == light ]]; then
    dim=white
    inactive='fg=#66707b,bg=#f0f2f4'
    status_fg='#ffffff'
  fi
  tmux set -g window-style "${inactive}" \
    \; set -g pane-border-style "fg=${dim}" \
    \; set -g pane-active-border-style "fg=${dim}" \
    \; set -g status-style "bg=green,fg=${status_fg}" \
    >/dev/null 2>&1 || true
fi

# nvim reloads itself off the state file, but the fs_event does not always
# survive; each instance also leaves a socket here.
if [[ -d "${NVIM_SOCKETS}" ]] && command -v nvim >/dev/null 2>&1; then
  for sock in "${NVIM_SOCKETS}"/*.sock; do
    [[ -S "${sock}" ]] || continue
    pid="$(basename "${sock}" .sock)"
    if ! kill -0 "${pid}" 2>/dev/null; then
      rm -f "${sock}"
      continue
    fi
    # Detached: --remote-expr blocks while that nvim sits in a prompt.
    ( nvim --server "${sock}" --remote-expr "execute('MateAppearance ${mode}')" >/dev/null 2>&1 & )
  done
fi

echo "${mode}"
