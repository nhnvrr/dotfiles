#!/usr/bin/env bash
#   mate              toggle light/dark
#   mate light|dark   force one, until the next system change
#   mate auto         follow macOS (what Hammerspoon calls)
#   mate status       print the active mode
set -euo pipefail

# Hammerspoon runs this through hs.task, which inherits launchd's PATH and has
# no /opt/homebrew/bin. herdr and nvim were silently not found there, so the
# files were rewritten and nothing was ever told to reload.
PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:${PATH}"

XDG_CONFIG="${XDG_CONFIG_HOME:-${HOME}/.config}"
ALACRITTY="${XDG_CONFIG}/alacritty"
ALACRITTY_DST="${ALACRITTY}/alacritty.toml"
STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/mate"
STATE="${STATE_DIR}/appearance"
NVIM_SOCKETS="${STATE_DIR}/nvim"

# Resolved through the symlink: this is usually run as ~/.local/bin/mate, and
# a plain dirname would put the repo at ~/.local.
self="${BASH_SOURCE[0]}"
while [[ -L "${self}" ]]; do
  link="$(readlink "${self}")"
  [[ "${link}" == /* ]] && self="${link}" || self="$(dirname "${self}")/${link}"
done
REPO="$(cd "$(dirname "${self}")/.." && pwd)"
ALACRITTY_SRC="${REPO}/alacritty/alacritty.toml"
HERDR_SRC="${REPO}/herdr/config.toml"
HERDR_DST="${XDG_CONFIG}/herdr/config.toml"

read_state() {
  [[ -r "${STATE}" ]] || return 1
  local w; w="$(tr -d '[:space:]' < "${STATE}")"
  [[ "${w}" == light || "${w}" == dark ]] || return 1
  printf '%s' "${w}"
}

system_mode() {
  # AppleInterfaceStyle is absent in light mode, not set to "Light".
  if defaults read -g AppleInterfaceStyle >/dev/null 2>&1; then printf dark; else printf light; fi
}

mode="${1:-toggle}"
case "${mode}" in
  status) read_state || system_mode; echo; exit 0 ;;
  toggle) [[ "$(read_state || system_mode)" == dark ]] && mode=light || mode=dark ;;
  auto)   mode="$(system_mode)" ;;
esac

case "${mode}" in
  dark)  palette="mate.toml" ;;
  light) palette="mate-light.toml" ;;
  *) echo "mate: expected light, dark, auto, toggle or status, got '${mode}'" >&2; exit 2 ;;
esac
[[ -e "${ALACRITTY}/${palette}" ]] || { echo "mate: ${ALACRITTY}/${palette} is missing" >&2; exit 1; }

# Generated, not linked: live_config_reload never fires on a symlinked config,
# so the file Alacritty was launched with has to be the one that changes.
[[ -L "${ALACRITTY_DST}" ]] && rm -f "${ALACRITTY_DST}"
if [[ -e "${ALACRITTY_SRC}" ]]; then
  tmp="$(mktemp)"
  sed -E "s|^import = \[\"~/\.config/alacritty/mate(-light)?\.toml\"\]$|import = [\"~/.config/alacritty/${palette}\"]|" \
    "${ALACRITTY_SRC}" > "${tmp}"
  grep -q "${palette}" "${tmp}" || { echo "mate: import line not found in ${ALACRITTY_SRC}" >&2; rm -f "${tmp}"; exit 1; }
  cat "${tmp}" > "${ALACRITTY_DST}"
  rm -f "${tmp}"
else
  echo "mate: ${ALACRITTY_SRC} not found" >&2; exit 1
fi

mkdir -p "${STATE_DIR}"
printf '%s\n' "${mode}" > "${STATE}"

# herdr has no include and its auto_switch needs DEC 2031, which Alacritty
# lacks, so the matching [theme.custom.<mode>] is flattened into [theme.custom].
if [[ -e "${HERDR_SRC}" ]]; then
  [[ -L "${HERDR_DST}" ]] && rm -f "${HERDR_DST}"
  if [[ "$(cd "$(dirname "${HERDR_SRC}")" && pwd)" == "$(cd "$(dirname "${HERDR_DST}")" 2>/dev/null && pwd)" ]]; then
    echo "mate: herdr source and destination are the same file" >&2; exit 1
  fi
  other=dark; [[ "${mode}" == dark ]] && other=light
  mkdir -p "$(dirname "${HERDR_DST}")"
  tmp="$(mktemp)"
  awk -v mode="${mode}" -v other="${other}" '
    /^\[/ {
      skip = 0
      if ($0 == "[theme.custom." other "]") { skip = 1; next }
      if ($0 == "[theme.custom." mode  "]") { print "[theme.custom]"; next }
    }
    skip { next }
    { print }
  ' "${HERDR_SRC}" > "${tmp}"
  mv -f "${tmp}" "${HERDR_DST}"
  command -v herdr >/dev/null 2>&1 && herdr server reload-config >/dev/null 2>&1 || true
else
  echo "mate: ${HERDR_SRC} not found, herdr not switched" >&2
fi

# nvim reloads itself off the state file, but the fs_event does not always
# survive; each instance also leaves a socket here.
if [[ -d "${NVIM_SOCKETS}" ]] && command -v nvim >/dev/null 2>&1; then
  for sock in "${NVIM_SOCKETS}"/*.sock; do
    [[ -S "${sock}" ]] || continue
    pid="$(basename "${sock}" .sock)"
    if ! kill -0 "${pid}" 2>/dev/null; then
      rm -f "${sock}"
      continue
    fi
    # Detached: --remote-expr blocks while that nvim sits in a prompt.
    ( nvim --server "${sock}" --remote-expr "execute('MateAppearance ${mode}')" >/dev/null 2>&1 & ) 
  done
fi

echo "${mode}"
