#compdef aws

# The upstream recipe is
#   autoload -Uz bashcompinit && bashcompinit && complete -C aws_completer aws
# which works but returns bare words: aws_completer prints candidates and
# nothing else, so `aws e<Tab>` gives a column of service names with no way to
# tell ecs from ecr. The descriptions below are joined in from the botocore
# models that ship inside the CLI itself, cached as TSV.
#
# This file IS the body of _aws — do not wrap it in a `_aws() { … }` and call
# it, or the definition replaces the autoloaded one and every call after the
# first runs with the setup above it missing.

(( $+commands[aws_completer] && $+commands[aws] )) || return 1

# :A resolves the symlink; the models sit next to the real binary, which under
# mise is several directories away from what is on $PATH. -g because the helpers
# below are global and outlive this call.
typeset -g __aws_models=${${:-$commands[aws]}:A:h}/awscli/botocore/data
typeset -g __aws_cache=$HOME/.cache/zsh/aws-completions

# Regenerate when the CLI is newer than the cache — a `mise up aws-cli` moves
# the models directory, which is the only signal the version changed.
__aws_stale() { [[ -f $1 && $1 -nt $__aws_models ]] && return 1 || return 0 }

__aws_service_table() {
  local f=$__aws_cache/services.tsv
  if __aws_stale $f; then
    mkdir -p $__aws_cache
    jq -r 'input_filename as $f
      | (($f | split("/"))[-3] | ascii_downcase | gsub("-"; ""))
        + "\t" + (.metadata.serviceFullName // .metadata.serviceId // "")' \
      $__aws_models/*/*/service-2.json >$f 2>/dev/null
  fi
  print -r -- $f
}

__aws_operation_table() {
  local f=$__aws_cache/$1.tsv
  if ! __aws_stale $f; then print -r -- $f; return; fi
  mkdir -p $__aws_cache
  jq -r 'def clean:
        (. // "")
      # the docs open with a support notice often enough that the first
      # sentence is the banner, not the summary
      | gsub("<(important|note)>.*?</(important|note)>"; " ")
      | gsub("<[^>]*>"; " ")
      | gsub("&lt;"; "<") | gsub("&gt;"; ">") | gsub("&quot;"; "\"")
      | gsub("&#39;"; "'"'"'") | gsub("&amp;"; "&")
      # POSIX classes, not \s: keeps the pattern valid without escaping games
      # in the shell quoting wrapped around it.
      | gsub("[[:space:]]+"; " ") | ltrimstr(" ") | rtrimstr(" ")
      | (capture("^(?<s>.*?[.])([[:space:]]|$)").s // .)
      | if length > 80 then (.[0:80] | sub("[[:space:]][^[:space:]]*$"; "")) else . end;
    .operations | to_entries[]
    | "\(.key | ascii_downcase)\t\(.value.documentation | clean)"' \
    $__aws_models/$1/*/service-2.json >$f 2>/dev/null
  print -r -- $f
}

# A handful of CLI command names do not match their model directory.
__aws_model_dir() {
  case $1 in
    s3api)         print s3 ;;
    configservice) print config ;;
    deploy)        print codedeploy ;;
    *)             print -r -- $1 ;;
  esac
}

# Which table applies depends on how deep the line already is: once a service
# name has appeared, describe its operations instead of the service list.
__aws_table() {
  local t d
  for t in ${words[2,CURRENT-1]}; do
    d=$(__aws_model_dir $t)
    if [[ -d $__aws_models/$d ]]; then
      __aws_operation_table $d
      return
    fi
  done
  __aws_service_table
}

__aws_query() {
  COMP_LINE=$1 COMP_POINT=${#1} aws_completer 2>/dev/null
}

# The model keys are lowercase and unhyphenated (listbuckets) while the CLI
# spells them list-buckets, so the join normalises before looking up.
__aws_describe() {
  local table
  (( $+commands[jq] )) && [[ -d $__aws_models ]] && table=$(__aws_table)
  if [[ -n $table && -s $table ]]; then
    local -a described
    described=(${(f)"$(print -rl -- "$@" | awk -F'\t' '
      NR == FNR { d[$1] = $2; next }
      { k = tolower($1); gsub(/-/, "", k)
        print (k in d && d[k] != "") ? $1 ":" d[k] : $1 }' $table -)"})
    _describe -t aws-commands 'aws' described && return 0
  fi
  local -a plain
  plain=("$@")
  compadd -a plain
}

local -a __out
local __line=${(j: :)words[1,CURRENT]}
local __token=${words[CURRENT]}

# --flag=value: aws_completer only understands the two as separate words, so it
# is asked that way and the flag is glued back onto every candidate.
if [[ $__token == --[a-z0-9-]##=* ]]; then
  __out=(${(f)"$(__aws_query "aws ${__token%%=*} ${__token#*=}")"})
  __out=(${${__out##[[:space:]]#}:#})
  (( $#__out )) && compadd -Q -P "${__token%%=*}=" -a __out
  return
fi

__out=(${(f)"$(__aws_query $__line)"})
__out=(${${__out##[[:space:]]#}:#})

if (( $#__out )); then
  __aws_describe $__out
  return
fi

# aws_completer knows nothing about bucket contents.
if [[ $__token == s3:* ]]; then
  local -a __keys
  if [[ $__token == s3:(|/|//)[^/]# ]]; then
    __keys=(${(f)"$(aws s3 ls 2>/dev/null | sed -n 's|.* \(.*\)$|s3://\1/|p')"})
  elif [[ $__token == s3://*/* ]]; then
    local __dir=${__token%/*}/
    __keys=(${(f)"$(aws s3 ls $__dir 2>/dev/null |
      sed -n -e 's|^ *PRE ||p' -e 's|^[0-9-]* [0-9:]* *[0-9]* ||p')"})
    __keys=(${__keys/#/$__dir})
  fi
  # -S '' so a prefix stays open for the next path component.
  (( $#__keys )) && compadd -S '' -a __keys
  return
fi

[[ $__token == -* ]] || _files
