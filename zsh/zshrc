typeset -Ag ABBRS=(
    gc  'git commit -m'
    gco 'git checkout'
    ga  'git add'
    gb  'git branch'
    gd  'git diff'
)

_abbr_expand_word() {
    local word=${LBUFFER##*[[:space:]]}
    [[ -n ${ABBRS[$word]-} ]] || return 1
    local head=${LBUFFER%$word}
    local -a before=(${(z)head})
    [[ -z ${before[-1]-} || ${before[-1]} == (';'|'&'|'|'|'&&'|'||'|'('|'!') ]] || return 1
    LBUFFER=$head${ABBRS[$word]}
}

_abbr_space() { _abbr_expand_word; zle self-insert }
_abbr_accept() { _abbr_expand_word; zle accept-line }
zle -N _abbr_space
zle -N _abbr_accept

req() {
    local out
    out=$(curl --silent --show-error --location --compressed \
        --connect-timeout 10 --max-time 60 --globoff "$@")
    local code=$?
    (( code != 0 )) && return $code

    if (( $+commands[jq] )) && printf '%s' "$out" | jq -e . >/dev/null 2>&1; then
        printf '%s' "$out" | jq .
    else
        printf '%s\n' "$out"
    fi
}

__tx() {
    local name=$1 dir
    case $name in
        dev)  dir=$HOME/develop ;;
        work) dir=$HOME/work ;;
        side) dir=$HOME/side ;;
        *)    print -u2 "__tx: unknown session '$name'"; return 1 ;;
    esac

    tmux has-session -t="$name" 2>/dev/null || tmux new-session -d -s "$name" -c "$dir"

    if [[ -z $TMUX ]]; then
        tmux attach-session -t "$name"
    else
        tmux switch-client -t "$name"
    fi
}

alias dev='__tx dev'
alias work='__tx work'
alias side='__tx side'

claude() {
    local dir=$HOME/.claude
    [[ $(tmux display-message -p '#S' 2>/dev/null) == work ]] && dir=$HOME/.claude-work
