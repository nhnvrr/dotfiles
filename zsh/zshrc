_cursor_apply() {
    if [[ $KEYMAP == vicmd ]]; then
        print -n '\e[2 q'
    elif [[ $ZLE_STATE == *overwrite* ]]; then
        print -n '\e[4 q'
    else
        print -n '\e[5 q'
    fi
}
add-zle-hook-widget zle-keymap-select _cursor_apply
add-zle-hook-widget zle-line-init _cursor_apply

_cursor_external() { print -n '\e[5 q' }

zmodload zsh/datetime
autoload -Uz add-zsh-hook

_notify_threshold=10
_notify_ignore=(nvim less man ssh tmux claude fzf watch top tail dev work side)

_notify_preexec() {
    _notify_start=$EPOCHREALTIME
    _notify_cmd=${${(z)1}[1]}
}

_notify_precmd() {
    local ret=$?
    local start=${_notify_start-}
    unset _notify_start
    [[ -n $start ]] || return $ret
    (( $_notify_ignore[(Ie)$_notify_cmd] )) && return $ret
    (( EPOCHREALTIME - start >= _notify_threshold )) && print -n '\a'
    return $ret
}

add-zsh-hook preexec _notify_preexec
add-zsh-hook preexec _cursor_external
add-zsh-hook precmd _notify_precmd

_docker_default_contexts=(default desktop-linux)

_docker_ctx_precmd() {
    local ret=$? ctx=${DOCKER_CONTEXT:-}
    if [[ -z $ctx && -r $HOME/.docker/config.json ]]; then
        [[ "$(<$HOME/.docker/config.json)" =~ '"currentContext"[[:space:]]*:[[:space:]]*"([^"]+)"' ]] \
            && ctx=$match[1]
    fi
    if [[ -n $ctx ]] && (( ! $_docker_default_contexts[(Ie)$ctx] )); then
        export STARSHIP_DOCKER_CTX=$ctx
    else
        unset STARSHIP_DOCKER_CTX
    fi
    return $ret
}
add-zsh-hook precmd _docker_ctx_precmd

_pnpm_precmd() {
    local ret=$? dir=$PWD
    while [[ -n $dir ]]; do
        if [[ -f $dir/pnpm-lock.yaml ]]; then
            export STARSHIP_PNPM=1
            return $ret
        fi
        [[ $dir == $HOME ]] && break
        dir=${dir%/*}
    done
    unset STARSHIP_PNPM
    return $ret
}
add-zsh-hook precmd _pnpm_precmd

