# Interactive zsh. Environment and $PATH live in zshenv.
#
# Load order matters twice in this file, and both are marked below:
#   - mise activates LAST so its prepend beats path_helper and ~/.bun/bin.
#   - zsh-syntax-highlighting sources LAST of all; it wraps every widget that
#     exists at the time, so anything binding keys after it is not highlighted.

stty -ixon 2>/dev/null

# --- history ----------------------------------------------------------------
# fish gave all of this for free.
HISTFILE="$HOME/.local/state/zsh/history"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS
setopt SHARE_HISTORY INC_APPEND_HISTORY EXTENDED_HISTORY

setopt AUTO_CD INTERACTIVE_COMMENTS NO_BEEP
setopt GLOB_DOTS NO_CASE_GLOB

# --- completion -------------------------------------------------------------
fpath=(${HOMEBREW_PREFIX:+${HOMEBREW_PREFIX}/share/zsh/site-functions}(N) "$HOME/.config/zsh/functions" $fpath)
autoload -Uz compinit
compinit -d "$HOME/.cache/zsh/zcompdump"

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.cache/zsh/zcompcache"

# aws ships a bash completer and nothing else. bashcompinit is the whole port
# of the 123-line hand-written fish completion that used to live here.
autoload -Uz bashcompinit && bashcompinit
command -v aws_completer >/dev/null && complete -C aws_completer aws

autoload -Uz "$HOME/.config/zsh/functions"/*(:t) 2>/dev/null

# --- vi mode ----------------------------------------------------------------
bindkey -v
KEYTIMEOUT=1

# Block in normal, blinking bar in insert. The cursor is the only vi-mode
# indicator: the prompt draws git state, not the keymap.
function _cursor_shape {
  case $KEYMAP in
    vicmd) printf '\e[2 q' ;;
    *)     printf '\e[5 q' ;;
  esac
}
function zle-keymap-select { _cursor_shape }
function zle-line-init { _cursor_shape }
zle -N zle-keymap-select
zle -N zle-line-init
precmd_functions+=(_cursor_shape)

# vi mode loses these, and they are worth more than the modality.
bindkey '^A' beginning-of-line
bindkey '^E' end-of-line
bindkey '^R' history-incremental-search-backward
bindkey -M viins '^?' backward-delete-char
bindkey -M viins '^W' backward-kill-word

# --- prompt -----------------------------------------------------------------
source "$HOME/.config/zsh/prompt.zsh"

# --- aws profile ------------------------------------------------------------
# ~/.aws/config has no [default] profile on purpose, so AWS_PROFILE must be
# explicit: work under ~/work, personal everywhere else.
function _aws_profile {
  case "$PWD" in
    "$HOME"/work|"$HOME"/work/*) export AWS_PROFILE=work ;;
    *)                           export AWS_PROFILE=personal ;;
  esac
}
autoload -Uz add-zsh-hook
add-zsh-hook chpwd _aws_profile
_aws_profile

# --- aliases ----------------------------------------------------------------
alias gc='git commit -m'
alias gco='git checkout'
alias ga='git add'
alias gb='git branch'
alias gd='git diff'

alias code='code --new-window'

# `?? cual es la capital de Francia?` -- noglob is not optional on either line.
# A question is full of the characters zsh globs: without it the trailing `?`
# and any `*` in the text make the whole command die on "no matches found"
# before ask ever runs. Aliasing ask itself gives the long name the same
# protection, and does not recurse -- an alias value that does not end in a
# space stops zsh expanding the word after it.
alias ask='noglob ask'
alias '??'='noglob ask'

# Not eza. The colour flag differs by platform: BSD ls takes -G, GNU ls takes
# --color. No LSCOLORS or LS_COLORS either way -- both defaults are fine.
if [[ "$MATE_OS" == darwin ]]; then
  export CLICOLOR=1
  _ls_colour='-G'
else
  _ls_colour='--color=auto'
fi
alias ls="ls ${_ls_colour}"
alias ll="ls -lh ${_ls_colour}"
alias la="ls -lhA ${_ls_colour}"

# bat is batcat on Debian: the name was already taken by a different package.
# Same for fd, which is fdfind. _mate_bat is the name the fzf previews below
# have to spell, since an alias does not reach a --preview subshell.
if (( $+commands[bat] )); then
  _mate_bat='bat'
elif (( $+commands[batcat] )); then
  _mate_bat='batcat'
  alias bat='batcat'
else
  _mate_bat='cat'
fi
if (( ! $+commands[fd] )) && (( $+commands[fdfind] )); then
  alias fd='fdfind'
fi

# pbcopy is macOS only; Wayland and X11 each have their own.
if (( $+commands[pbcopy] )); then
  _mate_clip='pbcopy'
elif (( $+commands[wl-copy] )); then
  _mate_clip='wl-copy'
elif (( $+commands[xclip] )); then
  _mate_clip='xclip -selection clipboard'
else
  _mate_clip='cat >/dev/null'
fi
alias clipcopy="${_mate_clip}"

# --- fzf --------------------------------------------------------------------
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS="
  --height 40% --layout=reverse --border=rounded
  --bind=\"ctrl-/:toggle-preview,ctrl-y:execute-silent(echo {} | ${_mate_clip})+abort\""
export FZF_CTRL_T_OPTS="--preview '${_mate_bat} --style=numbers --color=always --line-range :200 {}'"
export FZF_ALT_C_OPTS="--preview 'ls -lhA ${_ls_colour} {} | head -100'"
export FZF_CTRL_R_OPTS='
  --height=60%
  --preview="echo {} | bat --color=always --style=plain --language=sh"
  --preview-window=down:5:wrap
  --header="ctrl-y copy · ctrl-/ preview"'

source <(fzf --zsh)

# --- mise -------------------------------------------------------------------
# LAST but one: Homebrew's vendor_conf.d did this for fish, nothing does it for
# zsh. It prepends, so it has to run after path_helper and after ~/.bun/bin or
# the pinned runtime is shadowed.
eval "$(mise activate zsh)"

# --- zsh extras -------------------------------------------------------------
# What fish had built in. No plugin manager: brew formulas on macOS, the
# zsh-autosuggestions and zsh-syntax-highlighting apt packages on Debian, which
# land under /usr/share instead.
_mate_source_plugin() {
  local name="$1" dir
  for dir in \
    ${HOMEBREW_PREFIX:+${HOMEBREW_PREFIX}/share/${name}} \
    "/usr/share/${name}" \
    "/usr/share/zsh/plugins/${name}"; do
    if [[ -r "${dir}/${name}.zsh" ]]; then
      source "${dir}/${name}.zsh"
      return 0
    fi
  done
  return 1
}
_mate_source_plugin zsh-autosuggestions
bindkey '^ ' autosuggest-accept

# Strictly last: it wraps the widgets that exist when it loads.
_mate_source_plugin zsh-syntax-highlighting
