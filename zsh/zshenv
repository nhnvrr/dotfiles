# Read for every zsh, interactive or not. Only environment and $PATH go here.
#
# The $PATH order set below does NOT survive: macOS ships /etc/zprofile, which
# runs path_helper after this file and hoists /usr/bin and /bin to the front.
# That is why mise is activated at the END of .zshrc instead of here -- its
# prepend has to be the last word.

# macOS or Debian. Everything below that differs between them is decided here,
# once, so the rest of the file can stay flat.
export MATE_OS="${OSTYPE%%[0-9.]*}"

# Homebrew on macOS, or Linuxbrew if someone installed it; absent on a plain
# Debian, where the same tools come from apt and are already on PATH.
for _brew in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
  if [[ -x "${_brew}/bin/brew" ]]; then
    export HOMEBREW_PREFIX="${_brew}"
    export HOMEBREW_CELLAR="${_brew}/Cellar"
    export HOMEBREW_REPOSITORY="${_brew}"
    export INFOPATH="${_brew}/share/info${INFOPATH:+:$INFOPATH}"
    break
  fi
done
unset _brew

export LANG=en_US.UTF-8

# --wait, or git reads the still-empty buffer and aborts the commit.
export EDITOR="code --wait"
export VISUAL="code --wait"

export GOPATH="$HOME/Develop/go"
export GOPRIVATE=github.com/nhnvrr
if [[ "$MATE_OS" == darwin ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
else
  export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
fi

export AWS_PAGER=""
export AWS_RETRY_MODE=standard
export AWS_MAX_ATTEMPTS=3

export REDISCLI_HISTFILE="$HOME/.local/state/redis/history"
# -U dedups the array in place, which is what fish_add_path did for free.
typeset -U path PATH
# Entries that do not exist are harmless: zsh keeps them in the array but never
# finds anything there, and the (N) glob qualifier below drops them anyway.
path=(
  "$GOPATH/bin"
  ${HOMEBREW_PREFIX:+${HOMEBREW_PREFIX}/{bin,sbin}}
  ${HOMEBREW_PREFIX:+${HOMEBREW_PREFIX}/opt/libpq/bin}
  "$HOME/.bun/bin"
  "$HOME/.local/bin"
  "$PNPM_HOME/bin"
  "$HOME/.docker/bin"
  /usr/local/bin
  $path
)
# Drop what is not there, so `which` and completion do not stat dead paths on
# every lookup. (N) is the null glob qualifier; (-/) keeps only directories.
path=(${^path}(N-/))
