# Switch the terminal between dark and light: mate [dark|light]
# Terminal only: macOS appearance is left alone. Ghostty reloads on SIGUSR2.
# autoloaded: the file name is the function name.

local file="$HOME/.config/ghostty/mode.local" mode
case "$1" in
  '')
    if [[ "$(<"$file")" == *mate-light* ]] 2>/dev/null; then
      mode=dark
    else
      mode=light
    fi
    ;;
  dark|light) mode="$1" ;;
  *)
    print -u2 'mate: [dark|light]   — no argument toggles'
    return 2
    ;;
esac
print "theme = mate-$mode" >"$file"
pkill -USR2 -x ghostty
