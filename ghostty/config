font-family = MonaspiceAr Nerd Font Mono
# calt is NOT ligatures in Monaspace: it's texture healing, 276 substitutions to
# .left/.right glyph variants that nudge a glyph inside its own cell (the classic
# "il" gap). Cell width never changes, so the terminal grid holds. The ligatures
# live in liga and ss01-ss10, and those stay off.
font-feature = -liga, -dlig
font-size = 18
theme = Ghostty Default Style Dark

# background-opacity-cells stays false on purpose: only the theme's background
# goes translucent, so anything that paints its own cell background (tmux status
# bar, selections, nvim's cursorline) stays solid and legible. The blur is what
# keeps text readable over a busy desktop at this opacity.
background-opacity = 0.92
background-blur = 20

macos-icon = official

window-padding-x = 1
window-padding-y = 1
window-padding-balance = true

macos-titlebar-style = transparent
window-save-state = never
resize-overlay = never
adjust-cell-height = 6%
adjust-icon-height = 15%

cursor-style = bar
cursor-style-blink = true

command = /opt/homebrew/bin/fish --login
shell-integration = fish
shell-integration-features = cursor,sudo,title

macos-option-as-alt = true
quick-terminal-position = top
quick-terminal-screen = main
keybind = global:cmd+backquote=toggle_quick_terminal

bell-features = no-audio,no-system,attention,title,no-border
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true
