command = /opt/homebrew/bin/fish --login
shell-integration = fish
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,path

font-family = MonaspiceNe Nerd Font Mono
font-size = 14
font-feature = -liga, -dlig, -calt
adjust-cell-height = 1

macos-option-as-alt = true
fullscreen = true
macos-non-native-fullscreen = true

window-padding-x = 1
window-padding-y = 1
window-padding-balance = true
window-save-state = never
resize-overlay = never

cursor-style = bar
cursor-style-blink = true

copy-on-select = clipboard
mouse-hide-while-typing = true

background = #14171d
foreground = #c5c9c7

cursor-color = #c5c9c7

selection-background = #3E424A
selection-foreground = #c5c9c7

palette = 0=#14171d
palette = 1=#c4746e
palette = 2=#8a9a7b
palette = 3=#c4b28a
palette = 4=#8ba4b0
palette = 5=#a292a3
palette = 6=#8ea4a2
palette = 7=#a4a7a4

palette = 8=#5C6066
palette = 9=#e46876
palette = 10=#87a987
palette = 11=#e6c384
palette = 12=#7fb4ca
palette = 13=#938aa9
palette = 14=#7aa89f
palette = 15=#c5c9c7
