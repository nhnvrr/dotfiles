font-family = Berkeley Mono Trial
font-family = JetBrainsMono Nerd Font Mono
font-feature = -calt, -liga, -dlig
font-size = 14
theme = Nord Wave

# Both of these override the theme, so they MUST stay below it: ghostty applies
# the theme where the line appears and lets later keys win. Nord Wave ships a
# #212121 grey background; 208 is the orange the tmux bell uses.
background = #000000
palette = 208=#ff8700

macos-icon = official

window-padding-x = 1
window-padding-y = 1
window-padding-balance = true

macos-titlebar-style = transparent
window-save-state = never
resize-overlay = never
adjust-cell-height = 8%
# adjust-cell-height only rescales powerline glyphs, so the nerd font icons need
# their own bump to keep up with the taller cell.
adjust-icon-height = 15%

cursor-style = bar
cursor-style-blink = true

command = /bin/zsh --login
shell-integration = zsh
shell-integration-features = cursor,sudo,title

macos-option-as-alt = true
quick-terminal-position = top
quick-terminal-screen = main
keybind = global:cmd+backquote=toggle_quick_terminal

bell-features = no-audio,no-system,attention,title,no-border
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true
