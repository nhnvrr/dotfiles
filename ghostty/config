# Ghostty — the terminal for this profile. Settled: not Terminal.app, not
# Alacritty, not Warp. Native macOS build, real GPU renderer, ligature control
# and a config file that is a plain symlink — which is the whole reason the
# sixteen ANSI slots can live in this repo at all.

command = /bin/zsh --login
shell-integration = zsh
# ssh-env and ssh-terminfo are what make TERM=xterm-ghostty safe: Ghostty's
# terminfo entry exists on no remote host, and without these two `clear`, `less`
# and nvim break the moment you ssh anywhere.
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,path

# The Mono build, named in full. The cask installs three families whose names
# differ by one word and a family Ghostty cannot find falls back silently.
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
# Ligatures off: `!=` and `->` fusing into one glyph moves the column under a
# block cursor, and code is read here character by character.
font-feature = -liga, -dlig, -calt
adjust-cell-height = 1

macos-option-as-alt = true
keybind = cmd+r=reload_config
macos-non-native-fullscreen = true

window-padding-x = 2
window-padding-y = 2
window-padding-balance = true
window-save-state = never
resize-overlay = never
macos-titlebar-style = tabs

# A fixed title. Without this the titlebar carries whatever the foreground
# process last set — `herdr`, `nvim`, a full command line — which is noise: the
# information is already on screen, in herdr's own sidebar and in lualine.
#
# Setting this makes Ghostty ignore the title escape sequence outright, not just
# override it once. That only affects the window title; herdr owns the ptys in
# its panes and still parses those sequences itself, so `terminal_title_stripped`
# in herdr/config.toml keeps working.
#
# The one thing it costs is the 🔔 that `bell-features = title` prepends on a
# finished command. `system` and `attention` in that same list are untouched, so
# the notification and the Dock bounce still fire.
title = 🧉

cursor-style = bar
cursor-style-blink = true

copy-on-select = clipboard
mouse-hide-while-typing = true

# The bell is what zsh/zshrc rings when a long command finishes. `system` is the
# macOS notification, `attention` the Dock bounce. Needs Ghostty >= 1.1; an older
# build ignores the key and only logs a warning, and long commands then finish
# silently.
bell-features = system,attention,title

# ─── theme ──────────────────────────────────────────────────────────────────
#
# Jellybeans, dark only. Written out slot by slot rather than `theme = ...`:
# the bundled themes move with the Ghostty version, and these sixteen values are
# the single source of truth for the whole stack downstream — starship, bat,
# delta, fzf, psql, zsh-syntax-highlighting and herdr all resolve through them.
#
# The values are jellybeans.nvim's own `extras/ghostty` theme, so the terminal
# and the editor agree by construction, with two exceptions: upstream paints
# brred `#902020` (2.10:1) and brmagenta `#700089` (1.78:1), both of which are
# darker than their non-bright counterparts and effectively unreadable on this
# background. They are relit here to the lighter end of the same hue. Every slot
# now clears 3:1; body text lands at 12.50:1.
#
# The background is #242424 and not jellybeans' own #151515: near-black is a
# mirror in daylight, and the screen reflects the room back. #242424 is roughly
# 2.3x the luminance and every slot still clears the 3:1 floor — the worst is
# slot 1 at 3.57:1, and slot 8, which paints comments and autosuggestions
# everywhere, holds 4.38:1.
#
# Slot 0 stays at #151515 rather than following. It is ANSI black, drawn by
# programs that ask for black, and it needs to remain distinguishable from the
# background it sits on — which it no longer would if the two matched.
#
# selection-background moved with it. #404040 was 1.76:1 against the old
# background; against this one it fell to 1.50:1 and the selection stopped
# reading as one. #4a4a4a puts it back at 1.75:1.

background = #242424
foreground = #e8e8d3

cursor-color = #b0d0f0

selection-background = #4a4a4a
selection-foreground = #e8e8d3

palette = 0=#151515
palette = 1=#d74545
palette = 2=#99ad6a
palette = 3=#fad07a
palette = 4=#8197bf
palette = 5=#c6b6ee
palette = 6=#668799
palette = 7=#e8e8d3
palette = 8=#888888
palette = 9=#e06060
palette = 10=#70b950
palette = 11=#e6a75a
palette = 12=#8fbfdc
palette = 13=#d8ccf5
palette = 14=#8fbfdc
palette = 15=#f0f0f0

# Near-opaque only. Anything lower drops every contrast ratio above by whatever
# shows through, and the numbers here stop being true.
background-opacity = 0.97
background-blur = 20
