# Font — Source Code Pro (Adobe), parcheada como Nerd Font: los glyphs los
# necesita el prompt Tide (iconos de git, os, aws…).
# Cask: font-sauce-code-pro-nerd-font — "Sauce Code" es como Nerd Fonts
# renombra a Source Code Pro, no es un typo.
#
# El nombre de familia es el que reporta `ghostty +list-fonts`. El cask instala
# tres: NF (proporcional en los glyphs anchos), NFM (Mono, todo a ancho fijo) y
# NFP (Propo). Para terminal va la Mono: si un icono ocupa doble ancho, se
# desalinean las columnas del prompt y de cualquier TUI.
#
# Sin ligaduras, a diferencia de JetBrains Mono o Fira Code.
font-family = SauceCodePro Nerd Font Mono
font-size = 14

# Theme — Nord Wave, dark-only: misma paleta Nord (aurora/frost/snow storm) pero
# con fondo neutro #212121 en vez del #2E3440 azulado del Nord original.
# Nombre exacto de `ghostty +list-themes` (case-sensitive).
# Sin `background`/`background-opacity` propios: manda el tema, fondo sólido.
theme = Nord Wave

# Nord Wave define palette 8 (bright black) = #4c566a, que sobre su propio fondo
# #212121 da 2.18:1 — por debajo del 3:1 mínimo para texto no-cuerpo. Es el color
# con el que salen los hashes de `git log --oneline`, la metadata de `ls`, `man`
# y los headers de delta: todo el texto "dim" del sistema, ilegible.
# #616E88 (el "comment" de Nord) llega a 3.14:1 y sigue leyéndose como
# secundario. Mismo criterio que ya aplica fish/config.fish para Tide.
# palette 0 (#3b4252, 1.6:1) queda como está: es el negro normal y lo usan como
# FONDO las apps TUI, así que subirlo rompe más de lo que arregla.
palette = 8=#616E88

# Transparencia
# 0.92 es deliberadamente sutil: el fondo se insinúa sin competir con el texto.
# `background-blur` desenfoca lo que hay detrás — sin eso, una ventana con
# contenido variado atrás vuelve ilegible el texto tenue.
# `background-opacity-cells = false` (default) deja opacos los fondos de celda,
# así la selección y los resaltados siguen sólidos sobre el fondo translúcido.
#
# OJO con dos efectos:
#   · nvim corre con transparent = true, así que hereda ESTE fondo: el código
#     se ve sobre el escritorio, no sobre un color.
#   · los contrastes medidos contra #212121 (el gris #616E88 a 3.14:1) dejan de
#     valer, porque el fondo efectivo pasa a depender de lo que haya detrás.
# Por eso el toggle de abajo: apagarla cuando la legibilidad importa.
background-opacity = 0.92
background-blur = true
keybind = cmd+shift+o=toggle_background_opacity

# Window
window-padding-x = 2
window-padding-y = 2
macos-titlebar-style = transparent
# tmux ya persiste las sesiones; restaurar ventanas de Ghostty duplicaría estado.
window-save-state = never

# Cursor — beam parpadeante. Reemplaza el hook `\e[5 q` que tenía el zshrc:
# shell-integration se lo comunica a la shell y sobrevive a salir de nvim.
cursor-style = bar
cursor-style-blink = true

# Shell
shell-integration = fish
shell-integration-features = cursor,sudo,title

# Send Option as Alt — necesario para que Alt-C (fzf) llegue al shell.
macos-option-as-alt = true

# Drop-down quick terminal (toggle: cmd+grave)
quick-terminal-position = top
quick-terminal-screen = main

# UX
# Bell: el BEL lo maneja tmux (barra naranja) + el Dock. Explícito para no
# depender de los defaults de Ghostty:
#   no-audio    → sin sonido
#   no-system   → sin notificación de macOS (osascript resultaba ruidoso)
#   attention   → rebota el ícono del Dock cuando Ghostty está en background
#   title       → marca el título de la ventana
bell-features = no-audio,no-system,attention,title,no-border
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true
