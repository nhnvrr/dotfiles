font-family = Berkeley Mono Trial
font-family = JetBrainsMono Nerd Font Mono
font-feature = -calt, -liga, -dlig
font-size = 18
theme = Nord Wave

# These override the theme, so they MUST stay below it: ghostty applies the theme
# where the line appears and lets later keys win.
background = #000000
palette = 208=#ff8700

macos-icon = official

window-padding-x = 1
window-padding-y = 1
window-padding-balance = true

macos-titlebar-style = transparent
window-save-state = never
resize-overlay = never
# Berkeley Mono's cell is 0.500em wide, so nerd font icons hit the width limit long
# before any height limit. adjust-icon-height is inert here; this is the only knob
# that scales them.
adjust-cell-width = 12%
adjust-cell-height = 6%

cursor-style = bar
cursor-style-blink = true

command = /bin/zsh --login
shell-integration = zsh
shell-integration-features = cursor,sudo,title

macos-option-as-alt = true
quick-terminal-position = top
quick-terminal-screen = main
keybind = global:cmd+backquote=toggle_quick_terminal

bell-features = no-audio,no-system,attention,title,no-border
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true
