font-family = GeistMono Nerd Font Mono
font-feature = -calt, -liga, -dlig
font-size = 18
theme = iTerm2 Solarized Dark

# Solarized only defines slots 0-15, so 208 stays neon unless overridden here,
# below the theme line. tmux paints the bell status bar with it.
palette = 208=#cb4b16

macos-icon = official

window-padding-x = 1
window-padding-y = 1
window-padding-balance = true

macos-titlebar-style = transparent
window-save-state = never
resize-overlay = never
adjust-cell-height = 6%
adjust-icon-height = 15%

cursor-style = bar
cursor-style-blink = true

command = /bin/zsh --login
shell-integration = zsh
shell-integration-features = cursor,sudo,title

macos-option-as-alt = true
quick-terminal-position = top
quick-terminal-screen = main
keybind = global:cmd+backquote=toggle_quick_terminal

bell-features = no-audio,no-system,attention,title,no-border
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true
