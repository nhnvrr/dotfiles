# Berkeley primero: la primera declarada es la primaria, el resto son fallback.
# El trial trae 95 glifos (solo ASCII), así que sin la segunda línea los íconos
# del prompt y de eza los resuelve CoreText con Symbols Nerd Font, que es
# proporcional y descuadra las columnas.
font-family = Berkeley Mono Trial
font-family = JetBrainsMono Nerd Font Mono
font-feature = -calt, -liga, -dlig
font-size = 14
theme = Vercel

# Vercel define solo 0-15. tmux pinta la barra de colour208 cuando salta la
# campana; sin esto Ghostty lo saca de su cubo de 256 y el naranja cambia.
palette = 208=#ff8700

macos-icon = official
background-opacity = 0.83
background-blur = true
keybind = cmd+shift+o=toggle_background_opacity

window-padding-x = 0
window-padding-y = 0
window-padding-balance = true

macos-titlebar-style = transparent
window-save-state = never
resize-overlay = never
adjust-cell-height = 8%

cursor-style = bar
cursor-style-blink = true

command = /bin/zsh --login
shell-integration = zsh
shell-integration-features = cursor,sudo,title

macos-option-as-alt = true
quick-terminal-position = top
quick-terminal-screen = main
keybind = global:cmd+backquote=toggle_quick_terminal

bell-features = no-audio,no-system,attention,title,no-border
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true
