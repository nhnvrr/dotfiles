# Berkeley Mono (TX-02) primero, JetBrains Mono NFM como fallback. El segundo
# NO es opcional: el trial de Berkeley trae 95 glifos, solo ASCII imprimible.
# Todo lo demás —❯ del prompt, ❮ de vi, ⇡⇣ de git, ✘ del status, ∅ de psql y
# cada ícono Nerd Font— sale del fallback. Sin esa línea los elige CoreText.
#
# OJO: el trial vence 2026-08-03. Cuando expire hay que sacar la primera línea
# o comprar la licencia; si se desinstala la fuente, Ghostty cae al fallback en
# silencio y el único síntoma es que las letras cambian de forma.
#
# La variante Propo de JetBrains NO se puede: es proporcional y Ghostty solo
# acepta monoespaciadas (la ignora y cae a otro fallback sin avisar).
# JetBrains trae ligaduras; -calt/-liga/-dlig las apagan.
font-family = Berkeley Mono Trial
font-family = JetBrainsMono Nerd Font Mono
font-feature = -calt, -liga, -dlig
font-size = 21
theme = kanso-zen

# El icono oficial, sin retocar. `custom-style` está marcado como experimental
# upstream y sus capas pueden cambiar de formato entre versiones; esto no.
macos-icon = official

background-opacity = 0.92
background-blur = true
keybind = cmd+shift+o=toggle_background_opacity

window-padding-x = 14
window-padding-y = 10
# Reparte el sobrante entre los dos lados en vez de dejarlo todo a la derecha,
# que es lo que hace que el padding se vea disparejo al redimensionar.
window-padding-balance = true

# native: título en una sola línea. `tabs` integraba la tab bar de Ghostty en
# el titlebar y agregaba un segundo renglón — inútil acá, porque las pestañas
# las maneja tmux, no Ghostty.
macos-titlebar-style = native
window-save-state = never
resize-overlay = never
adjust-cell-height = 8%

cursor-style = bar
cursor-style-blink = true

# Explícito, no el login shell del sistema: durante una migración de shell el
# de `chsh` puede no ser todavía el que este repo configura. --login para que
# corra ~/.zprofile y arme el PATH.
command = /bin/zsh --login
shell-integration = zsh
shell-integration-features = cursor,sudo,title

macos-option-as-alt = true
quick-terminal-position = top
quick-terminal-screen = main
# `global:` para que funcione sin Ghostty en foco. La tecla es `backquote`,
# no `grave`: ese nombre Ghostty lo rechaza con error.InvalidFormat.
keybind = global:cmd+backquote=toggle_quick_terminal

bell-features = no-audio,no-system,attention,title,no-border
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true
