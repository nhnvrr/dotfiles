font-family = Ioskeley Mono Term
# Repeated font-family entries are fallbacks: Nerd Font glyphs for the fish prompt.
font-family = Symbols Nerd Font Mono
font-size = 14
adjust-cell-height = 1

cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false

macos-option-as-alt = true
macos-titlebar-style = transparent
window-theme = ghostty
macos-titlebar-proxy-icon = hidden
maximize = true
window-padding-x = 1
window-padding-y = 1
window-padding-balance = true
resize-overlay = never
window-save-state = never

shell-integration-features = ssh-env,ssh-terminfo
bell-features = no-attention,no-title,border

keybind = super+k=text:\x0c

split-divider-color = #4c566a
unfocused-split-opacity = 0.55
unfocused-split-fill = #14171e
