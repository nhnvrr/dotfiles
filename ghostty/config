font-family = MonaspiceAr Nerd Font Mono
font-feature = -liga, -dlig
font-size = 18
theme = Ghostty Default Style Dark

background-opacity = 1
background-blur = 20

macos-icon = official

window-padding-x = 1
window-padding-y = 1
window-padding-balance = true

macos-titlebar-style = transparent
window-save-state = never
resize-overlay = never
adjust-cell-height = 6%
adjust-icon-height = 15%

cursor-style = bar
cursor-style-blink = true

command = /opt/homebrew/bin/fish --login
shell-integration = fish
shell-integration-features = cursor,sudo,title

macos-option-as-alt = true
quick-terminal-position = top
quick-terminal-screen = main
keybind = global:cmd+backquote=toggle_quick_terminal

bell-features = no-audio,no-system,attention,title,no-border
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true
