# Only the deltas from pgcli's shipped defaults. pgcli does NOT read ~/.psqlrc,
# so anything shared with psql is duplicated here on purpose.

[main]

# psql parity: Enter runs the statement only when it ends in ';'.
multi_line = True

vi = True

less_chatty = True

syntax_style = nord

# Matches \pset null '∅' in psql/psqlrc.
null_string = '∅'

# drop/delete/update/truncate/alter already prompt by default; this also refuses
# to run them outside a transaction, so a bad WHERE stays rollback-able.
destructive_statements_require_transaction = True

# Credentials come from ~/.pgpass, not from the macOS Keychain.
keyring = False

# install.sh creates ~/.local/state/pgcli/ — pgcli won't, and without it history
# and logging fail silently. Same trap as psqlrc's HISTFILE.
history_file = ~/.local/state/pgcli/history
log_file = ~/.local/state/pgcli/log
log_level = ERROR

# Mirrors PROMPT1 in psql/psqlrc: the host is yellow, it's the field to check
# before typing anything destructive.
#   \u user · \h host · \d database · \# '@' if superuser, '>' otherwise
prompt = '\x1b[36m\u\x1b[0m@\x1b[1;33m\h\x1b[0m/\x1b[32m\d\x1b[0m\# '

# By ANSI slot, so the Ghostty theme drives these like it drives starship/eza/bat.
[colors]
completion-menu.completion.current      = 'bg:ansibrightblack ansiwhite'
completion-menu.completion              = 'bg:ansiblack ansiwhite'
completion-menu.meta.completion.current = 'bg:ansibrightblack ansibrightcyan'
completion-menu.meta.completion         = 'bg:ansiblack ansicyan'
completion-menu.multi-column-meta       = 'bg:ansiblack ansibrightblack'

scrollbar.arrow = 'bg:ansiblack'
scrollbar       = 'bg:ansibrightblack'

selected       = 'ansiwhite bg:ansibrightblack'
search         = 'ansiblack bg:ansicyan'
search.current = 'ansiblack bg:ansiyellow'

bottom-toolbar                    = 'bg:ansiblack ansiwhite'
bottom-toolbar.off                = 'bg:ansiblack ansibrightblack'
bottom-toolbar.on                 = 'bg:ansiblack ansiyellow'
bottom-toolbar.transaction.valid  = 'bg:ansiblack ansigreen'
bottom-toolbar.transaction.failed = 'bg:ansiblack ansired'

output.header = 'ansiyellow'
output.null   = 'ansibrightblack'

# The psql/psqlrc shortcuts, ported. Run with `\n <name>`, list them with `\n`.
# Each value MUST stay double-quoted: configobj splits unquoted values on commas
# and every one of these is a column list.
[named queries]

conns = "SELECT pid, usename, application_name, client_addr, state, wait_event_type, now() - query_start AS duration, left(query, 60) AS query FROM pg_stat_activity WHERE pid <> pg_backend_pid() AND state <> 'idle' ORDER BY duration DESC NULLS LAST"

blocking = "SELECT blocked.pid AS blocked_pid, blocked.query AS blocked_query, blocking.pid AS blocking_pid, blocking.query AS blocking_query FROM pg_stat_activity blocked JOIN pg_stat_activity blocking ON blocking.pid = ANY(pg_blocking_pids(blocked.pid)) WHERE cardinality(pg_blocking_pids(blocked.pid)) > 0"

locks = "SELECT l.pid, l.locktype, l.mode, l.granted, c.relname, left(a.query, 50) AS query FROM pg_locks l LEFT JOIN pg_class c ON c.oid = l.relation LEFT JOIN pg_stat_activity a ON a.pid = l.pid WHERE l.pid <> pg_backend_pid() ORDER BY l.granted, l.pid"

sizes = "SELECT schemaname AS schema, relname AS table, pg_size_pretty(pg_total_relation_size(relid)) AS total, pg_size_pretty(pg_relation_size(relid)) AS data, pg_size_pretty(pg_indexes_size(relid)) AS indexes FROM pg_catalog.pg_statio_user_tables ORDER BY pg_total_relation_size(relid) DESC LIMIT 25"

whoami = "SELECT current_user AS user, current_database() AS database, inet_server_addr() AS host, version() AS version"
